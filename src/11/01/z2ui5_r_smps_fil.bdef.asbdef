// Managed business object holding uploaded files. There is no public create:
// a file enters the BO only through the static action uploadFile, whose
// DEEP PARAMETER carries the file content, its MIME type and its name - the
// technique Fiori Elements renders as a file picker in the action dialog, and
// the one z2ui5_cl_smps_app_016 calls with EML instead.
managed implementation in class z2ui5_cl_smps_bp_fil unique;
strict ( 2 );

define behavior for z2ui5_r_smps_fil alias File
persistent table z2ui5_t_smps_fil
lock master
authorization master ( global )
etag master LastChangedAt
{
  // only the action creates - INTERNAL keeps CREATE out of reach of every
  // caller but the behavior pool itself
  internal create;
  delete;

  field ( numbering : managed, readonly ) FileUuid;

  // written by the action, never by the caller
  field ( readonly ) FileName, MimeType, Description, FileSize, Content;

  // filled by the managed runtime from the @Semantics annotations of the CDS
  field ( readonly ) CreatedBy, CreatedAt, LastChangedAt;

  static action uploadFile deep parameter z2ui5_a_smps_file_upload result [1] $self;

  mapping for z2ui5_t_smps_fil
    {
      FileUuid      = file_uuid;
      FileName      = file_name;
      MimeType      = mime_type;
      Description   = description;
      FileSize      = file_size;
      Content       = content;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedAt = last_changed_at;
    }
}
