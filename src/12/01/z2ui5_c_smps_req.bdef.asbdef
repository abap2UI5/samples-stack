// The projection exposes a SUBSET of z2ui5_r_smps_req: a consumer of this
// contract may change a request and approve it - nothing else. Create,
// delete, reject and the factory actions exist in the business object, but
// not here, so an EML statement against z2ui5_c_smps_req that names them
// does not even compile.
projection;
strict ( 2 );

define behavior for z2ui5_c_smps_req alias Request
{
  use update;

  use action approve;
}
